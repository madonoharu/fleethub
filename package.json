{
  "name": "fleethub",
  "private": true,
  "license": "UNLICENSED",
  "author": "madono (https://github.com/MadonoHaru) <madonoharu@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:site",
    "build:admin": "bun run --cwd packages/admin build",
    "build:core": "bash scripts/build-core.sh",
    "build:kcs": "bun run --cwd packages/kcs build",
    "build:site": "bun run --cwd packages/site build",
    "build:utils": "bun run --cwd packages/utils build",
    "dev": "bun run --cwd packages/site dev",
    "dispatch": "bun scripts/dispatch.ts",
    "dispatch-locally": "act -r workflow_dispatch --secret-file .env -e payload.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware packages scripts tests playwright.config.mts",
    "typecheck": "tsc --noEmit",
    "setup": "bun run build:utils && bun run build:kcs && bun run build:admin",
    "start": "bun run --cwd packages/site start",
    "test": "bun test --isolate --parallel=2 ./packages",
    "test:build": "bun test --isolate --path-ignore-patterns 'tests/e2e/**' ./tests/build",
    "test:core": "bun test --isolate --path-ignore-patterns 'tests/e2e/**' ./tests/core",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_MODE=dev playwright test",
    "update:locales": "bun scripts/updateLocales.ts",
    "update:maps": "bun --env-file=.env scripts/updateByKcnav.ts",
    "update:storage": "bun --env-file=.env scripts/updateStorage.ts",
    "update:types": "bun --env-file=.env scripts/updateTypes.ts",
    "redeploy": "bun --env-file=.env scripts/redeploy.ts",
    "lint:fix": "bun run lint --fix",
    "verify:build": "bun scripts/verify-build-traces.ts"
  },
  "devDependencies": {
    "@fh/admin": "workspace:*",
    "@fh/utils": "workspace:*",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.4",
    "equipment-bonus": "latest",
    "es-toolkit": "1.52.0",
    "fleethub-core": "latest",
    "fs-extra": "11.4.1",
    "kc-tools": "1.6.2",
    "ky": "2.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "gkcoi@1.7.2": "patches/gkcoi@1.7.2.patch"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
