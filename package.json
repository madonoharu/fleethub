{
  "name": "fleethub",
  "private": true,
  "license": "UNLICENSED",
  "author": "madono (https://github.com/MadonoHaru) <madonoharu@gmail.com>",
  "workspaces": [
    "packages/*",
    "crates/fleethub-core"
  ],
  "scripts": {
    "build": "bun run build:site",
    "build:admin": "bun run --cwd packages/admin build",
    "build:core": "bash scripts/build-core.sh",
    "build:kcs": "bun run --cwd packages/kcs build",
    "build:site": "bun run --cwd packages/site build",
    "build:utils": "bun run --cwd packages/utils build",
    "dev": "bun run --cwd packages/site dev",
    "dispatch": "bun scripts/dispatch.ts",
    "dispatch-locally": "act -r workflow_dispatch --secret-file .env -e payload.json",
    "prepare": "husky",
    "lint": "oxlint --type-aware packages scripts",
    "typecheck": "tsc --noEmit",
    "setup": "bun run build:core && bun run build:utils && bun run build:kcs && bun run build:admin",
    "start": "bun run --cwd packages/site start",
    "test": "node node_modules/jest/bin/jest.js",
    "update:locales": "bun scripts/updateLocales.ts",
    "update:maps": "bun --env-file=.env scripts/updateByKcnav.ts",
    "update:storage": "bun --env-file=.env scripts/updateStorage.ts",
    "update:types": "bun --env-file=.env scripts/updateTypes.ts",
    "redeploy": "bun --env-file=.env scripts/redeploy.ts",
    "lint:fix": "bun run lint --fix",
    "verify:build": "bun scripts/verify-build-traces.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "prettier --cache --write",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@fh/admin": "workspace:*",
    "@fh/utils": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "fleethub-core": "workspace:*",
    "fs-extra": "11.4.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "kc-tools": "1.6.2",
    "ky": "2.1.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "@types/lodash": "4.17.25",
    "lodash": "4.18.1"
  },
  "packageManager": "bun@1.4.2",
  "volta": {
    "node": "24.14.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.22.1"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
